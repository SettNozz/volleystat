# Local interpreters and environments (see AGENTS.md "Tests and validation")
volley_env_311/
.python/
.sam3_env/
.uv-cache/
.graphify_python

# Data, models and analysis results are provisioned per machine.
# Anchored to the repository root so packages such as action_recognition/data/
# and action_recognition/models/ stay tracked.
/data/
/models/
/results/
/notebooks/
action_recognition/models/checkpoints*/
action_recognition/models/experiments*/

# Weight files anywhere, so a checkpoint dropped next to code is still ignored
*.pt
*.pth
*.ckpt
*.onnx

# Media
*.mp4
*.avi
*.mov
*.gif

# Per-camera calibrations are runtime outputs; named setups live in
# configs/court_setups.json
court_calibration*.json
configs/court_calibration_*.json

# Personal paths and configurations
local_paths.json
personal_config.py

# Logs and MLflow
*.log
logs/
mlruns/
# Local MLflow model registry (scripts/models/run_mlflow_server.py).
# The database and the artifact copies are machine-local; what is shared is
# configs/model_registry.json, which says which names the pipeline resolves.
mlflow.db
mlflow.db-journal
mlartifacts/

# Temporary files
temp/
tmp/
*.tmp

# IDE and agent tooling
.idea/
.vscode/
.cursor/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Vendored, generated and scratch trees. None of these are sources: they are
# either downloaded, rebuilt from the code, or one-off review material.
